# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: verify PayPal webhooks (Apps & Credentials > your app > Webhooks)
PAYPAL_WEBHOOK_ID=
# Channel3 product search (trychannel3.com). Empty = offline demo catalog.
CHANNEL3_API_KEY=
# Claude API key for the web agent
ANTHROPIC_API_KEY=
# Public URL of this app; PayPal returns here after approval
ALLOWANCE_PUBLIC_URL=http://localhost:8000
ALLOWANCE_DB=data/allowance.db
